{
  "name": "frame-studio",
  "productName": "Frame Studio",
  "version": "0.1.0",
  "description": "Screen recording studio that turns raw captures into polished demos",
  "author": "Frame Studio",
  "license": "UNLICENSED",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && node scripts/launch-electron.js --dev\"",
    "vite": "vite",
    "build": "vite build",
    "start": "npm run build && node scripts/launch-electron.js",
    "dist": "npm run build && electron-builder --win",
    "test": "npm run test:unit && npm run test:electron",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:electron": "node tests/run-electron.js",
    "test:packaged": "node tests/run-packaged.js"
  },
  "build": {
    "appId": "com.frameflow.desktop",
    "productName": "Frame Studio",
    "copyright": "Copyright © 2026 Frame Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json",
      "assets/models/whisper/**/*",
      "!node_modules/onnxruntime-web/**",
      "!node_modules/onnxruntime-node/bin/napi-v3/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v3/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v3/win32/arm64/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/uiohook-napi/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "assets/models/whisper/**"
    ],
    "win": {
      "icon": "electron/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Frame-Studio-Setup-${version}.${ext}",
      "shortcutName": "Frame Studio",
      "uninstallDisplayName": "Frame Studio",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "ffmpeg-static": "^5.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "uiohook-napi": "^1.5.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "1.1.0",
    "@tailwindcss/vite": "^4.1.4",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.4.5",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.4",
    "vite": "^6.3.2",
    "wait-on": "^8.0.3"
  }
}
